{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "dept_bar_by_dept",
  "position": { "x": 10, "y": 172, "width": 620, "height": 340 },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "v_ChargebackByDepartment" } },
                  "Property": "Department"
                }
              },
              "queryRef": "v_ChargebackByDepartment.Department",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "v_ChargebackByDepartment" } },
                  "Property": "TotalCostWorkspace"
                }
              },
              "queryRef": "Sum(v_ChargebackByDepartment.TotalCostWorkspace)",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "v_ChargebackByDepartment" } },
                  "Property": "PricingCategory"
                }
              },
              "queryRef": "v_ChargebackByDepartment.PricingCategory",
              "active": true
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": { "SourceRef": { "Entity": "v_ChargebackByDepartment" } },
                "Property": "TotalCostWorkspace"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": { "expr": { "Literal": { "Value": "'Cost by Department'" } } },
            "show": { "expr": { "Literal": { "Value": "true" } } }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}

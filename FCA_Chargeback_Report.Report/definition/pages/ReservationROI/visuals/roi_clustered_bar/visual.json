{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.5.0/schema.json",
  "name": "roi_clustered_bar",
  "position": { "x": 10, "y": 172, "width": 750, "height": 320 },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": { "Entity": "v_ReservationSavingsSummary" }
                  },
                  "Property": "CapacityName"
                }
              },
              "queryRef": "v_ReservationSavingsSummary.CapacityName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": { "Entity": "v_ReservationSavingsSummary" }
                  },
                  "Property": "TotalEffectiveCost"
                }
              },
              "queryRef": "Sum(v_ReservationSavingsSummary.TotalEffectiveCost)",
              "active": true
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": { "Entity": "v_ReservationSavingsSummary" }
                  },
                  "Property": "TotalListCost"
                }
              },
              "queryRef": "Sum(v_ReservationSavingsSummary.TotalListCost)",
              "active": true
            }
          ]
        }
      }
    },
    "objects": {
      "title": [
        {
          "properties": {
            "text": {
              "expr": {
                "Literal": { "Value": "'Effective Cost vs List Cost by Capacity'" }
              }
            },
            "show": {
              "expr": {
                "Literal": { "Value": "true" }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
